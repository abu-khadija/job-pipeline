# Copy to .env and fill in. Never commit .env. Never export these globally.

# Anthropic API key from your PERSONAL console account (docs/SETUP-ISLAM.md A4).
ANTHROPIC_API_KEY=

# Google Sheet ID: the long part of the Sheet URL between /d/ and /edit (A5).
SHEET_ID=

# Path to the service-account JSON key, kept OUTSIDE this repo (A5-A6).
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# In GitHub Actions the whole JSON goes in the GOOGLE_SERVICE_ACCOUNT_JSON secret instead.

# Optional: a short digest after each run, sent only to YOUR OWN Telegram chat (SETUP A9).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nothing is ever sent while this is true. Sending code does not exist until Phase 3.
DRY_RUN=true

# Gmail over SMTP/IMAP with a Google App Password (no OAuth, never expires). Run `npm run gmail:connect`.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
